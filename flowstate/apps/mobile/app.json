{
  "expo": {
    "name": "FlowState",
    "slug": "flowstate",
    "version": "1.0.0",
    "scheme": "flowstate",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2f1700bd-3462-4b56-ab43-1169966df4fa"
    },
    "plugins": [
      "expo-updates",
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-document-picker",
      "expo-file-system",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FlowStateDay",
              "label": "FlowState — Today",
              "minWidth": "320dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Today's plan, must-do progress & module tracking",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FlowStateWeeklyStats",
              "label": "FlowState — Weekly Stats",
              "minWidth": "320dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "7-day session bar chart & streak counter",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FlowStateQuickLog",
              "label": "FlowState — Quick Log",
              "minWidth": "320dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "description": "One-tap module log status overview",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FlowStateGoalProgress",
              "label": "FlowState — Goals",
              "minWidth": "320dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Active goal progress with ahead/behind status",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ],
      "package": "com.anonymous.flowstate"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "2f1700bd-3462-4b56-ab43-1169966df4fa"
      }
    },
    "owner": "davids-labs"
  }
}
