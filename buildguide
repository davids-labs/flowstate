SECTION 7 — Key Code Patterns

7.1 The Timestamp Timer (most important pattern in the app)
// packages/core/src/timer/TimerEngine.ts
export class TimerEngine {
  private startedAt: number | null = null;
  private pausedAt: number | null = null;
  private totalPausedMs: number = 0;
  public blockDurationMs: number = 0;

  get remainingMs(): number {
    if (!this.startedAt) return this.blockDurationMs;
    const now = Date.now();
    const paused = this.pausedAt ? (now - this.pausedAt) : 0;
    const elapsed = now - this.startedAt - this.totalPausedMs - paused;
    return Math.max(0, this.blockDurationMs - elapsed);
  }

  get isOverdue(): boolean {
    if (!this.startedAt) return false;
    const now = Date.now();
    const paused = this.pausedAt ? (now - this.pausedAt) : 0;
    const elapsed = now - this.startedAt - this.totalPausedMs - paused;
    return elapsed > this.blockDurationMs;
  }

  play(durationMs: number) {
    this.blockDurationMs = durationMs;
    this.startedAt = Date.now();
    this.pausedAt = null;
    this.totalPausedMs = 0;
  }

  pause() {
    this.pausedAt = Date.now();
  }

  resume() {
    if (this.pausedAt) {
      this.totalPausedMs += Date.now() - this.pausedAt;
      this.pausedAt = null;
    }
  }
}

7.2 Countdown Component
// apps/mobile/components/modules/CountdownCard.tsx
export function CountdownCard({ spec }: { spec: ModuleSpec }) {
  const [remaining, setRemaining] = useState(() => computeRemaining(spec));

  useEffect(() => {
    const interval = setInterval(() => {
      setRemaining(computeRemaining(spec));
    }, 1000);
    return () => clearInterval(interval);
  }, [spec]);

  const { days, hours, minutes, seconds } = remaining;
  return (
    <View style={styles.card}>
      <Text style={styles.label}>{spec.emoji}  {spec.label}</Text>
      <Text style={styles.count}>{days}d  {hours}h  {minutes}m  {seconds}s</Text>
    </View>
  );
}

function computeRemaining(spec: ModuleSpec) {
  const target = new Date(spec.config.targetDate as string).getTime();
  const diff = Math.max(0, target - Date.now());
  return {
    days: Math.floor(diff / 86400000),
    hours: Math.floor((diff % 86400000) / 3600000),
    minutes: Math.floor((diff % 3600000) / 60000),
    seconds: Math.floor((diff % 60000) / 1000),
  };
}

