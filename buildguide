7.4 Firebase Sync with Device ID Filtering
// packages/core/src/firebase/sync.ts
const deviceId = generateOrLoadDeviceId(); // stored in AsyncStorage

export async function pushTimerState(state: TimerState) {
  try {
    await setDoc(doc(db, 'users', uid, 'timerState', 'active'), {
      ...state,
      deviceId,
      updatedAt: serverTimestamp(),
    });
  } catch (e) {
    await enqueueCommand({ type: 'TIMER_STATE', payload: state });
  }
}

export function listenTimerState(onUpdate: (state: TimerState) => void) {
  return onSnapshot(doc(db, 'users', uid, 'timerState', 'active'), (snap) => {
    if (!snap.exists()) return;
    const data = snap.data();
    if (data.deviceId === deviceId) return; // ignore own writes
    onUpdate(data as TimerState);
  });
}

 
